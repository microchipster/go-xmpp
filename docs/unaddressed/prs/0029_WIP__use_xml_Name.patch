diff --git a/auth.go b/auth.go
index 36ce19e..5125c98 100644
--- a/auth.go
+++ b/auth.go
@@ -43,7 +43,7 @@ func authPlain(socket io.ReadWriter, decoder *xml.Decoder, user string, password
